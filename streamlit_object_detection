      "source": [
        "%%writefile app.py\n",
        "import streamlit as st\n",
        "import numpy as np\n",
        "import tempfile\n",
        "from PIL import Image\n",
        "import tensorflow as tf\n",
        "from tensorflow.keras.applications.resnet50 import ResNet50, preprocess_input, decode_predictions\n",
        "from ultralytics import YOLO\n",
        "\n",
        "# -----------------------------\n",
        "# Load Models\n",
        "# -----------------------------\n",
        "@st.cache_resource\n",
        "def load_resnet50():\n",
        "    return ResNet50(weights=\"imagenet\")\n",
        "\n",
        "@st.cache_resource\n",
        "def load_yolo():\n",
        "    # Use pretrained YOLOv8n (downloads automatically)\n",
        "    return YOLO(\"yolov8n.pt\")\n",
        "\n",
        "resnet_model = load_resnet50()\n",
        "yolo_model = load_yolo()\n",
        "\n",
        "# -----------------------------\n",
        "# Prediction Functions\n",
        "# -----------------------------\n",
        "def run_resnet50(uploaded_file, top_n=3):\n",
        "    img = Image.open(uploaded_file).convert(\"RGB\")\n",
        "    img = img.resize((224, 224))\n",
        "    x = np.expand_dims(np.array(img), axis=0)\n",
        "    x = preprocess_input(x)\n",
        "    preds = resnet_model.predict(x)\n",
        "    decoded = decode_predictions(preds, top=top_n)[0]\n",
        "    return decoded\n",
        "\n",
        "def run_yolo(uploaded_file, conf_threshold=0.25):\n",
        "    with tempfile.NamedTemporaryFile(delete=False, suffix=\".jpg\") as tmp:\n",
        "        img = Image.open(uploaded_file).convert(\"RGB\")\n",
        "        img.save(tmp.name)\n",
        "        tmp_path = tmp.name\n",
        "\n",
        "    results = yolo_model.predict(tmp_path, conf=conf_threshold)\n",
        "\n",
        "    annotated_img = results[0].plot()\n",
        "    detections = []\n",
        "    for box in results[0].boxes:\n",
        "        cls_id = int(box.cls[0])\n",
        "        label = yolo_model.names[cls_id]\n",
        "        conf = float(box.conf[0])\n",
        "        detections.append((label, conf))\n",
        "    return annotated_img, detections\n",
        "\n",
        "# -----------------------------\n",
        "# Streamlit UI\n",
        "# -----------------------------\n",
        "st.set_page_config(page_title=\"Object Recognition App\", layout=\"wide\")\n",
        "\n",
        "st.title(\"Object Recognition with ResNet50 & YOLOv8\")\n",
        "st.markdown(\"\"\"\n",
        "This app allows you to test **two powerful object recognition techniques**:\n",
        "- **ResNet50** – Image classification model trained on ImageNet\n",
        "- **YOLOv8** – Object detection model trained on COCO dataset\n",
        "\"\"\")\n",
        "\n",
        "st.sidebar.header(\"Choose Settings\")\n",
        "model_choice = st.sidebar.radio(\"Select Model\", [\"ResNet50\", \"YOLOv8\"])\n",
        "\n",
        "# Slider for YOLO confidence\n",
        "conf_th = st.sidebar.slider(\"YOLO Confidence Threshold\", 0.1, 1.0, 0.25, 0.05)\n",
        "\n",
        "# Slider for ResNet top predictions\n",
        "top_n = st.sidebar.slider(\"Top-N Predictions (ResNet50)\", 1, 10, 3, 1)\n",
        "\n",
        "uploaded_file = st.file_uploader(\"Upload an image\", type=[\"jpg\", \"jpeg\", \"png\"])\n",
        "\n",
        "if uploaded_file:\n",
        "    st.image(uploaded_file, caption=\"Uploaded Image\", use_container_width=True)\n",
        "\n",
        "    if model_choice == \"ResNet50\":\n",
        "        preds = run_resnet50(uploaded_file, top_n=top_n)\n",
        "        st.subheader(f\"ResNet50 Top {top_n} Predictions:\")\n",
        "        for _, label, prob in preds:\n",
        "            st.write(f\"**{label}** – {prob*100:.2f}% confidence\")\n",
        "\n",
        "    elif model_choice == \"YOLOv8\":\n",
        "        annotated, dets = run_yolo(uploaded_file, conf_threshold=conf_th)\n",
        "        st.image(annotated, caption=\"YOLOv8 Detection Result\", use_container_width=True)\n",
        "\n",
        "        st.subheader(\"YOLOv8 Detections:\")\n",
        "        for label, conf in dets:\n",
        "            st.write(f\"**{label}** – {conf*100:.2f}% confidence\")\n",
        "\n",
        "# -----------------------------\n",
        "# Extra Information\n",
        "# -----------------------------\n",
        "st.sidebar.markdown(\"---\")\n",
        "st.sidebar.subheader(\"Dataset Details\")\n",
        "st.sidebar.markdown(\"\"\"\n",
        "- **ResNet50** trained on **ImageNet** (1000 classes)\n",
        "- **YOLOv8** trained on **COCO** (80 classes)\n",
        "\"\"\")\n",
        "\n",
        "st.sidebar.subheader(\"About Project\")\n",
        "st.sidebar.markdown(\"\"\"\n",
        "This project demonstrates the use of **Deep Learning** for image understanding:\n",
        "- **ResNet50** for classification\n",
        "- **YOLOv8** for detection\n",
        "\n",
        "Choose a model, upload an image, and explore predictions interactively 🚀\n",
        "\"\"\")\n"
